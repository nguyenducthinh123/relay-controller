<Window x:Class="Relay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Relay.ViewModels"
        mc:Ignorable="d"
        Title="USB Relay Controller (LCUS &amp; HID)" Height="450" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F0F2F5"
        Icon="app_icon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh kết nối & Quét thiết bị -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thiết bị:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                <ComboBox Grid.Column="1" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName"/>
                <Button Grid.Column="2" Content="🔍 Quét &amp; Auto Connect" Padding="12,4" Margin="0,0,6,0" 
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" Cursor="Hand"
                        Command="{Binding ScanAndAutoConnectCommand}"/>
                <Button Grid.Column="3" Content="{Binding ConnectButtonText}" Padding="14,4" 
                        Background="{Binding ConnectButtonBrush}" Foreground="White" FontWeight="SemiBold" Cursor="Hand"
                        Command="{Binding ToggleConnectCommand}"/>
            </Grid>
        </Border>

        <!-- 2. Danh sách 4 Kênh Relay (Data Binding qua ItemsControl) -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Rows="2" Margin="-6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Margin="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, StringFormat='CH: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,4,0,10" FontWeight="SemiBold"/>
                            <Button Content="{Binding ButtonText}" Background="{Binding ButtonBrush}" Foreground="White" 
                                    Height="36" FontWeight="Bold" Cursor="Hand"
                                    IsEnabled="{Binding IsButtonEnabled}"
                                    Command="{Binding ToggleCommand}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. Status Bar nền trắng trực quan -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" 
                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>