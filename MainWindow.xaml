<Window x:Class="Relay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Relay"
        mc:Ignorable="d"
        Title="Apps điều khiển relay" Height="450" Width="520"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F0F2F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh kết nối & Quét COM -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cổng COM:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                <ComboBox Name="cboPorts" Grid.Column="1" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Name="btnScan" Grid.Column="2" Content="🔍 Quét &amp; Auto Connect" Padding="12,4" Margin="0,0,6,0" 
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" Click="btnScan_Click" Cursor="Hand"/>
                <Button Name="btnConnect" Grid.Column="3" Content="Kết nối" Padding="14,4" 
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold" Click="btnConnect_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 2. Danh sách 4 Kênh Relay -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="-6">
            <!-- CH1: Nguồn B+ -->
            <Border Background="White" CornerRadius="8" Margin="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CH1: NGUỒN (B+)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                    <TextBlock Name="txtStatus1" Text="○ INACTIVE (OFF)" FontSize="11" Foreground="#64748B" Margin="0,4,0,10" FontWeight="SemiBold"/>
                    <Button Name="btnCh1" Content="BẬT NGUỒN" Height="36" Background="#475569" Foreground="White" 
                            FontWeight="Bold" Tag="1" Click="RelayButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- CH2: Boot Mode -->
            <Border Background="White" CornerRadius="8" Margin="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CH2: BOOT MODE" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                    <TextBlock Name="txtStatus2" Text="○ INACTIVE (OFF)" FontSize="11" Foreground="#64748B" Margin="0,4,0,10" FontWeight="SemiBold"/>
                    <Button Name="btnCh2" Content="BẬT BOOT" Height="36" Background="#475569" Foreground="White" 
                            FontWeight="Bold" Tag="2" Click="RelayButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- CH3: IGN -->
            <Border Background="White" CornerRadius="8" Margin="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CH3: IGNITION" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                    <TextBlock Name="txtStatus3" Text="○ INACTIVE (OFF)" FontSize="11" Foreground="#64748B" Margin="0,4,0,10" FontWeight="SemiBold"/>
                    <Button Name="btnCh3" Content="BẬT IGN" Height="36" Background="#475569" Foreground="White" 
                            FontWeight="Bold" Tag="3" Click="RelayButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- CH4: Dự phòng -->
            <Border Background="White" CornerRadius="8" Margin="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CH4: DỰ PHÒNG" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                    <TextBlock Name="txtStatus4" Text="○ INACTIVE (OFF)" FontSize="11" Foreground="#64748B" Margin="0,4,0,10" FontWeight="SemiBold"/>
                    <Button Name="btnCh4" Content="BẬT CH4" Height="36" Background="#475569" Foreground="White" 
                            FontWeight="Bold" Tag="4" Click="RelayButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. Status Bar nền trắng sạch đẹp -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Name="txtSystemStatus" Text="Sẵn sàng. Bấm 'Quét &amp; Auto Connect' để tự động tìm thiết bị." 
                       FontSize="12" Foreground="#1E293B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>